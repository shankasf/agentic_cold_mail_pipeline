generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User role enum
enum UserRole {
  ADMIN
  SALES_REP
}

// User model for authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(SALES_REP)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations - owned resources
  sesIdentities       SESIdentity[]
  sequences           Sequence[]
  uploads             Upload[]
  businesses          Business[]
  campaigns           Campaign[]
  leads               Lead[]
  emailDrafts         EmailDraft[]
  emailExports        EmailExport[]
  templateUploads     TemplateUpload[]
  templateFileUploads TemplateFileUpload[]
  emailTemplates      EmailTemplate[]

  @@map("users")
}

// Upload status enum
enum UploadStatus {
  QUEUED
  PARSED
  FAILED
}

// Evidence type enum
enum EvidenceType {
  EMAIL_FOUND
  INDUSTRY
  SERVICES
  TOOLS
  PAIN_POINT
  LOCATION
  OTHER
}

// Email draft status enum
enum EmailStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  EXPORTED
  SENT
  REPLIED
  BOUNCED
  COMPLAINT
}

// Export type enum
enum ExportType {
  CSV
  PDF
  BATCH_ZIP
}

// Email event type enum (AWS SES supported events)
enum EmailEventType {
  SENT              // Send request successful
  DELIVERED         // Successfully delivered to mail server
  OPEN              // Recipient opened the email
  CLICK             // Recipient clicked a link
  BOUNCE            // Hard bounce - permanent rejection
  COMPLAINT         // Marked as spam by recipient
  REJECT            // Rejected (virus detected)
  DELIVERY_DELAY    // Temporary delivery issue
  SUBSCRIPTION      // Recipient updated subscription preferences
  RENDERING_FAILURE // Template rendering failed
  REPLY             // Recipient replied
}

// Suppression reason enum
enum SuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
}

// Template category enum
enum TemplateCategory {
  SALES
  DEMO
  PARTNERSHIP
  SUPPORT
  WEBINAR
  PRODUCT_LAUNCH
}

// Pipeline type enum
enum PipelineType {
  AGENTIC
  TEMPLATE
}

// Campaign status enum
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// SES Identity status enum
enum SESIdentityStatus {
  PENDING      // Verification email sent, awaiting confirmation
  VERIFIED     // Identity verified and ready to use
  WARMING      // In warmup phase, volume limited
  ACTIVE       // Fully active, no restrictions
  PAUSED       // Temporarily disabled by user
  ERROR        // Verification failed or other error
}

// SES Identity type enum
enum IdentityType {
  EMAIL        // Individual email address
  DOMAIN       // Domain identity (e.g., @callsphere.tech)
}

// Sequence status enum
enum SequenceStatus {
  DRAFT        // Being edited
  ACTIVE       // Running and sending
  PAUSED       // Temporarily stopped
  COMPLETED    // All leads processed
  ARCHIVED     // No longer in use
}

// Campaign model - organizes businesses and outreach efforts
model Campaign {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses      Business[]
  uploads         Upload[]
  leads           Lead[]
  leadColumns     LeadColumn[]
  businessColumns BusinessColumn[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

// Uploads table
model Upload {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  campaignId   String?      @map("campaign_id")
  filename     String
  fileType     String       @map("file_type")
  sizeBytes    Int          @map("size_bytes")
  storagePath  String       @map("storage_path")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  status       UploadStatus @default(QUEUED)
  progressText String?      @map("progress_text")
  errorText    String?      @map("error_text")

  user     User?             @relation(fields: [userId], references: [id])
  campaign Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  chunks   ParsedChunk[]
  evidence BusinessEvidence[]

  @@index([userId])
  @@index([campaignId])
  @@map("uploads")
}

// Parsed chunks table
model ParsedChunk {
  id          String @id @default(uuid())
  uploadId    String @map("upload_id")
  chunkIndex  Int    @map("chunk_index")
  textContent String @map("text_content")
  sourceMeta  Json   @map("source_meta") // { page?, sheet?, rowStart?, rowEnd? }
  hash        String

  upload       Upload                 @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  evidence     BusinessEvidence[]
  observations IndustryObservation[]

  @@unique([uploadId, hash])
  @@map("parsed_chunks")
}

// Businesses table
model Business {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  campaignId    String?  @map("campaign_id")
  canonicalName String   @unique @map("canonical_name")
  website       String?
  industryGuess String?  @map("industry_guess")
  location      String?

  // Dynamic columns - stores ALL extra data from imports for AI to use
  customData    Json     @default("{}") @map("custom_data") // { columnName: value, ... }

  // AI enrichment data - gathered by agents
  enrichmentData Json    @default("{}") @map("enrichment_data") // { painPoints: [], insights: [], etc. }

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User?                 @relation(fields: [userId], references: [id])
  campaign      Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  evidence      BusinessEvidence[]
  observations  IndustryObservation[]
  emailDrafts   EmailDraft[]
  sequenceLeads SequenceLead[]
  inboundEmails InboundEmail[]

  @@index([userId])
  @@index([campaignId])
  @@index([industryGuess])
  @@index([location])
  @@index([createdAt])
  @@map("businesses")
}

// Contacts table
model Contact {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  email            String   @unique
  name             String?
  role             String?
  phone            String?  // Contact phone number
  linkedinUrl      String?  @map("linkedin_url") // LinkedIn profile
  sourceConfidence Int      @default(0) @map("source_confidence")

  // Dynamic columns - stores ALL extra contact data from imports for AI to use
  customData       Json     @default("{}") @map("custom_data") // { columnName: value, ... }

  createdAt        DateTime @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  emailDrafts   EmailDraft[]
  sequenceLeads SequenceLead[]
  inboundEmails InboundEmail[]

  @@index([businessId])
  @@index([createdAt])
  @@map("contacts")
}

// Business evidence table
model BusinessEvidence {
  id             String       @id @default(uuid())
  businessId     String       @map("business_id")
  uploadId       String       @map("upload_id")
  chunkId        String       @map("chunk_id")
  evidenceType   EvidenceType @map("evidence_type")
  extractedValue String       @map("extracted_value")
  confidence     Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  upload   Upload      @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  chunk    ParsedChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([uploadId])
  @@map("business_evidence")
}

// Industry playbook table
model IndustryPlaybook {
  id              String   @id @default(uuid())
  industry        String   @unique
  commonPainPoints Json    @map("common_pain_points") // string[]
  valueProps      Json     @map("value_props") // string[]
  subjectAngles   Json     @map("subject_angles") // string[]
  safeClaims      Json     @map("safe_claims") // string[]
  bannedPhrases   Json     @map("banned_phrases") // string[]
  lastUpdatedAt   DateTime @default(now()) @map("last_updated_at")

  @@map("industry_playbook")
}

// Industry observations table
model IndustryObservation {
  id              String   @id @default(uuid())
  industry        String
  businessId      String   @map("business_id")
  observation     String
  evidenceChunkId String   @map("evidence_chunk_id")
  confidence      Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunk    ParsedChunk @relation(fields: [evidenceChunkId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([industry])
  @@map("industry_observations")
}

// Email drafts table
model EmailDraft {
  id                    String       @id @default(uuid())
  userId                String?      @map("user_id")
  businessId            String       @map("business_id")
  contactId             String       @map("contact_id")
  fromName              String       @default("CallSphere") @map("from_name")
  fromEmail             String       @default("sagar@callsphere.tech") @map("from_email")
  subject               String
  bodyText              String       @map("body_text")
  footerText            String       @map("footer_text")
  personalizationTokens Json         @map("personalization_tokens") // { facts_used: [], pain_point?, industry? }
  confidenceScore       Int          @default(0) @map("confidence_score")
  deliverabilityScore   Int          @default(0) @map("deliverability_score")
  spamFlags             Json         @default("[]") @map("spam_flags") // string[]
  status                EmailStatus  @default(DRAFT)
  pipelineType          PipelineType @default(AGENTIC) @map("pipeline_type") // AGENTIC or TEMPLATE
  templateId            String?      @map("template_id") // If from template pipeline
  parentEmailId         String?      @map("parent_email_id") // For follow-up emails (thread)
  threadId              String?      @map("thread_id") // Groups emails in same conversation
  sentAt                DateTime?    @map("sent_at") // When email was actually sent
  // SES tracking fields
  sesIdentityId         String?      @map("ses_identity_id")
  sesMessageId          String?      @unique @map("ses_message_id") // For tracking SES events & replies
  // Timestamps
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user          User?          @relation(fields: [userId], references: [id])
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sesIdentity   SESIdentity?   @relation(fields: [sesIdentityId], references: [id])
  events        EmailEvent[]
  parentEmail   EmailDraft?    @relation("EmailThread", fields: [parentEmailId], references: [id])
  replies       EmailDraft[]   @relation("EmailThread")
  inboundReplies InboundEmail[]

  @@index([userId])
  @@index([businessId])
  @@index([contactId])
  @@index([status])
  @@index([createdAt])
  @@index([threadId])
  @@index([sesIdentityId])
  @@map("email_drafts")
}

// Email exports table
model EmailExport {
  id         String     @id @default(uuid())
  userId     String?    @map("user_id")
  exportType ExportType @map("export_type")
  filters    Json
  filePath   String     @map("file_path")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_exports")
}

// Email events table
model EmailEvent {
  id                String         @id @default(uuid())
  emailDraftId      String         @map("email_draft_id")
  eventType         EmailEventType @map("event_type")
  providerMessageId String?        @map("provider_message_id")
  eventPayload      Json           @default("{}") @map("event_payload")
  createdAt         DateTime       @default(now()) @map("created_at")

  emailDraft EmailDraft @relation(fields: [emailDraftId], references: [id], onDelete: Cascade)

  @@index([emailDraftId])
  @@index([eventType])
  @@index([createdAt])
  @@map("email_events")
}

// Suppression list table
model SuppressionList {
  email     String            @id
  reason    SuppressionReason
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("suppression_list")
}

// Admin settings table (single row)
model AdminSettings {
  id                    String   @id @default(uuid())
  businessAddress       String   @default("27 Orchard Pl, New York, NY 12601") @map("business_address")
  calendlyUrl           String   @default("https://calendly.com/sagar-callsphere/new-meeting") @map("calendly_url")
  confidenceThreshold   Int      @default(70) @map("confidence_threshold")
  deliverabilityThreshold Int    @default(70) @map("deliverability_threshold")
  maxWords              Int      @default(110) @map("max_words")
  sendingCapPerDay      Int      @default(100) @map("sending_cap_per_day")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

// =============================================================================
// SES IDENTITY MANAGEMENT & WARMUP
// =============================================================================

// SES Identity model for multi-sender management
model SESIdentity {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  emailAddress    String            @unique @map("email_address")
  displayName     String?           @map("display_name")
  identityType    IdentityType      @default(EMAIL) @map("identity_type")
  // SES-specific tracking
  sesIdentityArn  String?           @map("ses_identity_arn")
  configSetName   String?           @map("config_set_name")
  // Status and warmup
  status          SESIdentityStatus @default(PENDING)
  warmupEnabled   Boolean           @default(false) @map("warmup_enabled")
  warmupDay       Int               @default(0) @map("warmup_day")
  dailyLimit      Int               @default(50) @map("daily_limit")
  sentToday       Int               @default(0) @map("sent_today")
  lastSentAt      DateTime?         @map("last_sent_at")
  // Reputation tracking
  bounceRate      Float             @default(0) @map("bounce_rate")
  complaintRate   Float             @default(0) @map("complaint_rate")
  // Timestamps
  verifiedAt      DateTime?         @map("verified_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDrafts   EmailDraft[]
  sequences     Sequence[]
  inboundEmails InboundEmail[]

  @@index([userId])
  @@index([status])
  @@map("ses_identities")
}

// =============================================================================
// MULTI-STEP SEQUENCES (CAMPAIGN AUTOMATION)
// =============================================================================

// Email sequence/campaign
model Sequence {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  name          String
  description   String?
  status        SequenceStatus @default(DRAFT)
  // Settings
  sesIdentityId String?        @map("ses_identity_id")
  timezone      String         @default("America/New_York")
  sendingDays   Json           @default("[1,2,3,4,5]") @map("sending_days") // 0=Sun, 1=Mon, etc.
  sendingHours  Json           @default("{\"start\": 9, \"end\": 17}") @map("sending_hours")
  // Stats
  totalLeads    Int            @default(0) @map("total_leads")
  activeLeads   Int            @default(0) @map("active_leads")
  completedLeads Int           @default(0) @map("completed_leads")
  // Timestamps
  startedAt     DateTime?      @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sesIdentity SESIdentity?     @relation(fields: [sesIdentityId], references: [id])
  steps       SequenceStep[]
  leads       SequenceLead[]

  @@index([userId])
  @@index([status])
  @@map("sequences")
}

// Individual step in a sequence
model SequenceStep {
  id              String   @id @default(uuid())
  sequenceId      String   @map("sequence_id")
  stepNumber      Int      @map("step_number")
  delayDays       Int      @default(1) @map("delay_days")
  delayHours      Int      @default(0) @map("delay_hours")
  // Email content
  subjectTemplate String   @map("subject_template")
  bodyTemplate    String   @map("body_template")
  // Conditions
  skipIfReplied   Boolean  @default(true) @map("skip_if_replied")
  skipIfClicked   Boolean  @default(false) @map("skip_if_clicked")
  skipIfOpened    Boolean  @default(false) @map("skip_if_opened")
  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  sequence Sequence           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leads    SequenceLeadStep[]

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
  @@map("sequence_steps")
}

// Lead enrolled in a sequence
model SequenceLead {
  id           String    @id @default(uuid())
  sequenceId   String    @map("sequence_id")
  contactId    String    @map("contact_id")
  businessId   String    @map("business_id")
  // Progress tracking
  currentStep  Int       @default(1) @map("current_step")
  status       String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, REPLIED, BOUNCED, UNSUBSCRIBED
  // Timestamps
  enrolledAt   DateTime  @default(now()) @map("enrolled_at")
  completedAt  DateTime? @map("completed_at")
  lastActionAt DateTime? @map("last_action_at")

  // Relations
  sequence Sequence           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps    SequenceLeadStep[]

  @@unique([sequenceId, contactId])
  @@index([sequenceId])
  @@index([contactId])
  @@index([status])
  @@map("sequence_leads")
}

// Track which steps have been executed for each lead
model SequenceLeadStep {
  id             String    @id @default(uuid())
  sequenceLeadId String    @map("sequence_lead_id")
  stepId         String    @map("step_id")
  emailDraftId   String?   @map("email_draft_id")
  // Status
  status         String    @default("PENDING") // PENDING, SCHEDULED, SENT, SKIPPED
  scheduledFor   DateTime? @map("scheduled_for")
  sentAt         DateTime? @map("sent_at")
  skippedReason  String?   @map("skipped_reason")
  // Timestamps
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  sequenceLead SequenceLead @relation(fields: [sequenceLeadId], references: [id], onDelete: Cascade)
  step         SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([sequenceLeadId, stepId])
  @@index([sequenceLeadId])
  @@index([status])
  @@map("sequence_lead_steps")
}

// =============================================================================
// UNIFIED INBOX (UNIBOX) - Inbound Email Tracking
// =============================================================================

// Inbound email replies received via SES
model InboundEmail {
  id              String   @id @default(uuid())
  sesMessageId    String   @unique @map("ses_message_id")
  // Sender info
  fromEmail       String   @map("from_email")
  fromName        String?  @map("from_name")
  toEmail         String   @map("to_email")
  // Content
  subject         String
  bodyText        String?  @map("body_text")
  bodyHtml        String?  @map("body_html")
  // Threading
  inReplyTo       String?  @map("in_reply_to") // Original SES message ID
  references      String?  // Email thread references header
  threadId        String?  @map("thread_id")
  // Linked records
  originalEmailId String?  @map("original_email_id")
  contactId       String?  @map("contact_id")
  businessId      String?  @map("business_id")
  sesIdentityId   String?  @map("ses_identity_id")
  // Status
  isRead          Boolean  @default(false) @map("is_read")
  isArchived      Boolean  @default(false) @map("is_archived")
  isStarred       Boolean  @default(false) @map("is_starred")
  // Raw data
  rawPayload      Json?    @map("raw_payload")
  // Timestamps
  receivedAt      DateTime @default(now()) @map("received_at")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  originalEmail EmailDraft?  @relation(fields: [originalEmailId], references: [id])
  contact       Contact?     @relation(fields: [contactId], references: [id])
  business      Business?    @relation(fields: [businessId], references: [id])
  sesIdentity   SESIdentity? @relation(fields: [sesIdentityId], references: [id])

  @@index([fromEmail])
  @@index([threadId])
  @@index([originalEmailId])
  @@index([isRead])
  @@index([receivedAt])
  @@map("inbound_emails")
}

// =============================================================================
// TEMPLATE PIPELINE MODELS (Non-Agentic)
// =============================================================================

// Template file uploads (txt, pdf, docx) for creating templates
model TemplateFileUpload {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  filename          String
  fileType          String   @map("file_type")
  sizeBytes         Int      @map("size_bytes")
  storagePath       String   @map("storage_path")
  content           String   @default("") // Extracted text content
  status            String   @default("QUEUED") // QUEUED, PARSED, FAILED
  errorText         String?  @map("error_text")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  createdTemplateId String?  @unique @map("created_template_id")

  user            User?          @relation(fields: [userId], references: [id])
  createdTemplate EmailTemplate? @relation(fields: [createdTemplateId], references: [id])

  @@index([userId])
  @@map("template_file_uploads")
}

// Email templates with variable placeholders
model EmailTemplate {
  id              String           @id @default(uuid())
  userId          String?          @map("user_id")
  category        TemplateCategory
  name            String           // "Sales Outreach - SaaS"
  description     String?
  subjectTemplate String           @map("subject_template") // "{{company}} - Quick Question"
  bodyTemplate    String           @map("body_template")    // "Hi {{name}},\n\n..."
  variables       Json             @default("[\"name\", \"company\", \"role\", \"industry\"]") // Required variables
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user       User?               @relation(fields: [userId], references: [id])
  uploads    TemplateUpload[]
  sourceFile TemplateFileUpload?

  @@index([userId])
  @@map("email_templates")
}

// Template CSV uploads
model TemplateUpload {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  templateId   String       @map("template_id")
  filename     String
  fileType     String       @map("file_type")
  sizeBytes    Int          @map("size_bytes")
  storagePath  String       @map("storage_path")
  totalRows    Int          @default(0) @map("total_rows")
  processedRows Int         @default(0) @map("processed_rows")
  status       UploadStatus @default(QUEUED)
  progressText String?      @map("progress_text")
  errorText    String?      @map("error_text")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")

  user     User?         @relation(fields: [userId], references: [id])
  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rows     TemplateRow[]

  @@index([userId])
  @@map("template_uploads")
}

// Individual rows from template CSV
model TemplateRow {
  id           String   @id @default(uuid())
  uploadId     String   @map("upload_id")
  rowIndex     Int      @map("row_index")
  email        String
  name         String?
  company      String?
  role         String?
  industry     String?
  customFields Json     @default("{}") @map("custom_fields") // Any extra columns
  status       String   @default("PENDING") // PENDING, PROCESSED, SKIPPED, ERROR
  errorText    String?  @map("error_text")
  emailDraftId String?  @map("email_draft_id") // Link to generated email
  createdAt    DateTime @default(now()) @map("created_at")

  upload TemplateUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([status])
  @@map("template_rows")
}

// =============================================================================
// CAMPAIGN LEADS MANAGEMENT (Instantly-style)
// =============================================================================

// Lead status enum
enum LeadStatus {
  NOT_CONTACTED     // New lead, not yet contacted
  CONTACTED         // Email sent
  OPENED            // Email opened
  CLICKED           // Link clicked
  REPLIED           // Lead replied
  INTERESTED        // Positive reply / interested
  MEETING_BOOKED    // Meeting scheduled
  NOT_INTERESTED    // Negative reply
  BOUNCED           // Email bounced
  UNSUBSCRIBED      // Lead unsubscribed
  OUT_OF_OFFICE     // Auto-reply detected
}

// Lead model - individual prospects in a campaign
model Lead {
  id              String     @id @default(uuid())
  campaignId      String     @map("campaign_id")
  userId          String     @map("user_id")

  // Core lead info
  email           String
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  company         String?
  title           String?    // Job title
  phone           String?
  linkedinUrl     String?    @map("linkedin_url")
  website         String?
  location        String?
  industry        String?

  // Email provider info (detected)
  emailProvider   String?    @map("email_provider") // Google, Microsoft, etc.
  emailSecurity   String?    @map("email_security") // Security gateway detected

  // Status tracking
  status          LeadStatus @default(NOT_CONTACTED)
  lastContactedAt DateTime?  @map("last_contacted_at")

  // Dynamic columns - stores custom/enriched data
  customColumns   Json       @default("{}") @map("custom_columns") // { columnName: value }

  // Enrichment tracking
  enrichmentData  Json       @default("{}") @map("enrichment_data") // AI research results
  lastEnrichedAt  DateTime?  @map("last_enriched_at")

  // Tags for organization
  tags            Json       @default("[]") // string[]

  // Source tracking
  source          String?    // manual, import, api, etc.
  sourceFile      String?    @map("source_file") // Original filename if imported

  // Timestamps
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  campaign        Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([email])
  @@index([company])
  @@index([createdAt])
  @@map("leads")
}

// Custom column definitions for a campaign
model LeadColumn {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  name        String   // Column display name
  key         String   // Column key in customColumns JSON
  type        String   @default("text") // text, number, date, url, email, select
  options     Json     @default("[]") // For select type: available options
  isRequired  Boolean  @default(false) @map("is_required")
  isEnriched  Boolean  @default(false) @map("is_enriched") // Created by AI enrichment
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
  @@index([campaignId])
  @@map("lead_columns")
}

// Business column definitions - tracks all custom columns imported for businesses
model BusinessColumn {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  name        String   // Original column name from import
  key         String   // Normalized key in customData JSON
  mappedTo    String?  @map("mapped_to") // If mapped to standard field: name, website, industry, location, contact_email, contact_name, contact_role
  type        String   @default("text") // text, number, date, url, email
  sampleValues Json    @default("[]") @map("sample_values") // First 3 values for preview
  aiHint      String?  @map("ai_hint") // AI-generated description of what this column contains
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, key])
  @@index([campaignId])
  @@map("business_columns")
}

// =============================================================================
// REPUTATION & METRICS TRACKING
// =============================================================================

// Daily metrics snapshot for identities (for 30-day moving average)
model IdentityDailyMetrics {
  id            String   @id @default(uuid())
  identityId    String   @map("identity_id")
  date          DateTime @db.Date

  // Sending metrics
  sent          Int      @default(0)
  delivered     Int      @default(0)
  bounced       Int      @default(0)
  complained    Int      @default(0)
  rejected      Int      @default(0)

  // Engagement metrics
  opened        Int      @default(0)
  clicked       Int      @default(0)
  replied       Int      @default(0)
  unsubscribed  Int      @default(0)

  // Calculated rates (stored for quick queries)
  bounceRate    Float    @default(0) @map("bounce_rate")
  complaintRate Float    @default(0) @map("complaint_rate")
  openRate      Float    @default(0) @map("open_rate")
  clickRate     Float    @default(0) @map("click_rate")
  replyRate     Float    @default(0) @map("reply_rate")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([identityId, date])
  @@index([identityId])
  @@index([date])
  @@map("identity_daily_metrics")
}

// Reputation alerts history
model ReputationAlert {
  id            String   @id @default(uuid())
  identityId    String?  @map("identity_id") // null for system-wide alerts
  alertType     String   @map("alert_type") // bounce_rate, complaint_rate, warmup_pause, etc.
  severity      String   // warning, critical
  message       String
  value         Float    // The metric value that triggered the alert
  threshold     Float    // The threshold that was exceeded

  // Status
  isResolved    Boolean  @default(false) @map("is_resolved")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?  @map("resolved_by") // User ID who resolved

  // Metadata
  metadata      Json     @default("{}")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([identityId])
  @@index([alertType])
  @@index([createdAt])
  @@index([isResolved])
  @@map("reputation_alerts")
}

// System-wide daily metrics (aggregate across all identities)
model SystemDailyMetrics {
  id            String   @id @default(uuid())
  date          DateTime @db.Date @unique

  // Aggregate metrics
  totalSent     Int      @default(0) @map("total_sent")
  totalDelivered Int     @default(0) @map("total_delivered")
  totalBounced  Int      @default(0) @map("total_bounced")
  totalComplaints Int    @default(0) @map("total_complaints")
  totalOpened   Int      @default(0) @map("total_opened")
  totalClicked  Int      @default(0) @map("total_clicked")
  totalReplied  Int      @default(0) @map("total_replied")

  // Rates
  overallBounceRate    Float @default(0) @map("overall_bounce_rate")
  overallComplaintRate Float @default(0) @map("overall_complaint_rate")
  overallOpenRate      Float @default(0) @map("overall_open_rate")
  overallClickRate     Float @default(0) @map("overall_click_rate")
  overallReplyRate     Float @default(0) @map("overall_reply_rate")

  // Active identities
  activeIdentities Int   @default(0) @map("active_identities")
  pausedIdentities Int   @default(0) @map("paused_identities")

  // AI service metrics
  aiCalls       Int      @default(0) @map("ai_calls")
  aiErrors      Int      @default(0) @map("ai_errors")
  aiTokensUsed  Int      @default(0) @map("ai_tokens_used")
  avgAiLatencyMs Int     @default(0) @map("avg_ai_latency_ms")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("system_daily_metrics")
}
